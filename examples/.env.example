# Example environment variables for PalaRez StreamCam CLI scripts
# Copy to `.env` in the repo root (`.env` is gitignored — never commit real keys).

# Your phone's LAN address shown in the PalaRez StreamCam top bar
PALAREZ_PHONE_URL=http://192.0.2.10:8890

# Your YouTube Studio RTMP/RTMPS Stream Key (from studio.youtube.com -> Go Live)
YOUTUBE_STREAM_KEY_PALAREZ=xxxx-xxxx-xxxx-xxxx-xxxx

# Optional: paths for multi-track album broadcasting (scripts/album_live_orchestrator.py)
PALAREZ_M3U=./examples/sample_album.m3u
PALAREZ_TRACKS_DIR=./tracks
PALAREZ_YT_TOKEN=./youtube_token.json
PALAREZ_YT_CLIENT_SECRET=./client_secret.json
